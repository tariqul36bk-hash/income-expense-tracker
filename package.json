  },
  "dependencies": {
    "react": "^19.0.0-rc",
    "react-dom": "^19.0.0-rc",
    "next": "^15.0.0",
    "@supabase/supabase-js": "^2.38.4",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.4.2",
    "tailwindcss": "^3.3.0",
    "lucide-react": "^0.356.0",
    "recharts": "^2.10.3",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0",
    "zustand": "^4.4.1",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "next-themes": "^0.2.1",
    "react-hot-toast": "^2.4.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
