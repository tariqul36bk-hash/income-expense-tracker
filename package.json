{
  "name": "income-expense-tracker",
  "version": "1.0.0",
  "description": "A production-ready Income & Expense Tracker web app built with Next.js 15, TypeScript, Tailwind CSS, and Supabase",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
